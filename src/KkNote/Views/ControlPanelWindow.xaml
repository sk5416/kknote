<Window x:Class="KkNote.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:KkNote.Views"
        Title="超级桌面便签"
        Width="560"
        Height="520"
        MinWidth="500"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AutomationProperties.AutomationId="ControlPanel">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="2"/>
        <RowDefinition Height="40"/>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource AccentLineBrush}"/>

      <Grid Grid.Row="1" Margin="14,0,8,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="超级桌面便签" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
          <TextBlock Text="Ctrl+Alt+N" Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}"
                     FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="—" Style="{StaticResource IconButton}" Margin="0,0,6,0"
                  ToolTip="隐藏到托盘" AutomationProperties.Name="隐藏面板"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Hide_Click"/>
          <Button Content="×" Style="{StaticResource IconButton}"
                  ToolTip="隐藏到托盘，程序仍在运行" AutomationProperties.Name="关闭面板"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Hide_Click"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" Margin="12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="文本页" Style="{StaticResource GhostButton}"
                  Padding="14,6" AutomationProperties.AutomationId="NewNote" AutomationProperties.Name="新建文本页"
                  ToolTip="Ctrl+N" Click="New_Click"/>
          <Button Content="待办页" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                  Padding="14,6" AutomationProperties.AutomationId="NewTodo" AutomationProperties.Name="新建待办页"
                  Click="NewTodo_Click"/>
          <Button Content="待办管理" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                  Padding="14,6" AutomationProperties.AutomationId="OpenTodos" AutomationProperties.Name="待办管理"
                  ToolTip="管理全部待办事项" Click="OpenTodos_Click"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="3" Margin="12,0,12,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="168"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <ListBox x:Name="NoteList"
                   AutomationProperties.AutomationId="NoteList"
                   SelectionChanged="NoteList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="8" Height="8" CornerRadius="4" Margin="0,3,8,0" VerticalAlignment="Top"
                          Background="{Binding Background, Converter={StaticResource HexBrush}}"/>
                  <StackPanel Grid.Column="1">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="桌面" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding PinnedToDesktop}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock DockPanel.Dock="Right" Text="待办" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Foreground" Value="{StaticResource VioletBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsTodo}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding DisplaySnippet}" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="还没有页。点击「新建」。"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                     Margin="8" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Items.Count, ElementName=NoteList}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <Grid Grid.Column="2">
          <TextBlock x:Name="EmptyHint" Text="选择一页，或新建一页。"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}"/>
          <Grid x:Name="Editor" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="TitleBox" Grid.Row="0" Style="{StaticResource FieldTextBox}" MaxLength="80"
                     AutomationProperties.AutomationId="NoteTitle" AutomationProperties.Name="标题"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

            <views:NoteStyleBar x:Name="StyleBar" Grid.Row="1" Margin="0,8,0,8"
                                Collapsible="False" Dark="True"/>

            <Border x:Name="BodyHost" Grid.Row="2" CornerRadius="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Padding="6,6,6,8"
                    Background="{Binding Background, Converter={StaticResource HexBrush}}">
              <Grid>
                <Grid x:Name="TextHost">
                  <TextBox x:Name="BodyBox" Style="{StaticResource NoteBody}"
                           AutomationProperties.AutomationId="NoteBody" AutomationProperties.Name="正文"
                           Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                           Foreground="{Binding FontColor, Converter={StaticResource HexBrush}}"
                           FontSize="{Binding FontSize}"
                           FontFamily="{Binding FontFamily}"
                           Language="zh-CN"/>
                  <TextBlock Text="写点什么…" Margin="16,12,12,0" VerticalAlignment="Top"
                             IsHitTestVisible="False" Foreground="#9A8F80">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <views:TodoListView x:Name="TodoHost" Visibility="Collapsed"/>
              </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal">
                <ToggleButton Content="显示在桌面" Style="{StaticResource CheckToggle}" Margin="0,0,8,0"
                              IsChecked="{Binding PinnedToDesktop}"
                              AutomationProperties.AutomationId="PinDesktop" AutomationProperties.Name="显示在桌面"/>
                <ToggleButton Content="单独列示" Style="{StaticResource CheckToggle}" Margin="0,0,8,0"
                              IsChecked="{Binding Detached}"
                              AutomationProperties.AutomationId="SpreadPages" AutomationProperties.Name="单独列示"
                              ToolTip="从纸沓里拆出这一页，单独成窗"/>
                <ToggleButton Content="保持最前" Style="{StaticResource CheckToggle}"
                              IsChecked="{Binding AlwaysOnTop}"
                              AutomationProperties.AutomationId="KeepOnTop" AutomationProperties.Name="保持最前"/>
              </StackPanel>
              <Button x:Name="DeleteButton" Content="删除" Style="{StaticResource DangerButton}"
                      HorizontalAlignment="Right"
                      AutomationProperties.AutomationId="DeleteNote" AutomationProperties.Name="删除"
                      Click="Delete_Click"/>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
