<UserControl x:Class="KkNote.Views.NoteStyleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KkNote.Views"
             Background="Transparent">
  <StackPanel>
    <ToggleButton x:Name="Toggle"
                  Style="{StaticResource PaperToggle}"
                  Content="格式"
                  Height="26"
                  HorizontalAlignment="Left"
                  Padding="10,2"
                  AutomationProperties.Name="格式"
                  Checked="Toggle_Changed"
                  Unchecked="Toggle_Changed"/>
    <Border x:Name="Panel"
            Visibility="Collapsed"
            Margin="0,6,0,0"
            Padding="8,8,8,6"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="#D9CDBB"
            Background="#FBF6EE">
      <StackPanel>
        <TextBlock x:Name="PaperLabel" Text="纸色" FontSize="11" Margin="0,0,0,6" Foreground="#9A8F80"/>
        <WrapPanel x:Name="BgSwatches" Margin="0,0,0,8"/>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="FontBox" Style="{StaticResource DarkCombo}" Height="28"
                    ItemsSource="{x:Static views:FontCatalog.Families}"
                    SelectionChanged="FontBox_SelectionChanged"/>
          <ComboBox x:Name="SizeBox" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource DarkCombo}" Height="28"
                    ItemsSource="{x:Static views:FontCatalog.Sizes}"
                    SelectionChanged="SizeBox_SelectionChanged"/>
          <ToggleButton x:Name="BoldBox" Grid.Column="2" Margin="6,0,0,0" Content="B" FontWeight="Bold"
                        Width="28" Height="28" Padding="0" Style="{StaticResource PaperToggle}"
                        Checked="BoldBox_Changed" Unchecked="BoldBox_Changed"/>
        </Grid>
        <TextBlock x:Name="InkLabel" Text="字色" FontSize="11" Margin="0,0,0,6" Foreground="#9A8F80"/>
        <WrapPanel x:Name="FgSwatches"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
