<UserControl x:Class="KkNote.Views.NotePagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             SnapsToDevicePixels="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="36"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" MinHeight="96">
      <TextBox x:Name="Body"
               Style="{StaticResource NoteBody}"
               AutomationProperties.AutomationId="NoteBody"
               AutomationProperties.Name="正文"
               TextChanged="Body_TextChanged"
               Language="zh-CN"/>
      <TextBlock x:Name="Placeholder"
                 Text="写点什么…"
                 Margin="14,10,12,0"
                 VerticalAlignment="Top"
                 IsHitTestVisible="False"
                 Foreground="{StaticResource MutedBrush}"/>
    </Grid>

    <Grid Grid.Row="1" Margin="8,0,8,6">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="PrevButton" Content="‹" Style="{StaticResource IconButton}" Margin="0,0,4,0"
                AutomationProperties.AutomationId="PrevPage" AutomationProperties.Name="上一页"
                ToolTip="上一页" Click="Prev_Click"/>
        <TextBlock x:Name="PageLabel" Text="1/1" Width="42" VerticalAlignment="Center"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        <Button x:Name="NextButton" Content="›" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                AutomationProperties.AutomationId="NextPage" AutomationProperties.Name="下一页"
                ToolTip="下一页" Click="Next_Click"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="AddButton" Content="加页" Style="{StaticResource GhostButton}" Padding="8,2" Height="28" Margin="0,0,6,0"
                AutomationProperties.AutomationId="AddPage" AutomationProperties.Name="加页"
                Click="Add_Click"/>
        <Button x:Name="RemoveButton" Content="减页" Style="{StaticResource GhostButton}" Padding="8,2" Height="28"
                AutomationProperties.AutomationId="RemovePage" AutomationProperties.Name="减页"
                Click="Remove_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
