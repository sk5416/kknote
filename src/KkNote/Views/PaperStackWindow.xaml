<Window x:Class="KkNote.Views.PaperStackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="便签"
        Width="320"
        Height="380"
        MinWidth="240"
        MinHeight="210"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#EFE6D4"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI"
        AutomationProperties.AutomationId="StickyNote">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border x:Name="Root" BorderThickness="1" Background="#EFE6D4" BorderBrush="#D9CDBB">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid x:Name="Header" Grid.Row="0" Background="#F6F0E4">
        <TextBox x:Name="TitleBox"
                 Style="{StaticResource TitleInput}"
                 Margin="12,0,148,0"
                 VerticalAlignment="Center"
                 Foreground="#2A3340"
                 AutomationProperties.AutomationId="StickyTitle"
                 AutomationProperties.Name="便签标题"
                 TextChanged="TitleBox_TextChanged"
                 shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
          <ToggleButton x:Name="PinButton"
                        AutomationProperties.AutomationId="ToggleTopmost"
                        AutomationProperties.Name="置顶"
                        ToolTip="是否保持在最前"
                        Checked="PinButton_Changed" Unchecked="PinButton_Changed"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <ToggleButton.Style>
              <Style TargetType="ToggleButton" BasedOn="{StaticResource PaperToggle}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="MinWidth" Value="52"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Content" Value="置顶"/>
                <Style.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="已置顶"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ToggleButton.Style>
          </ToggleButton>
          <Button x:Name="CloseButton" Content="×" Style="{StaticResource PaperIconButton}" Margin="6,0,0,0"
                  AutomationProperties.AutomationId="UnpinNote"
                  AutomationProperties.Name="取消固化"
                  ToolTip="把当前页从桌面拿下来，内容仍留在面板"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Unpin_Click"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="Deck" Grid.Row="1" Margin="10,4,10,4" ClipToBounds="False">
        <Grid x:Name="PeekLayer"/>
        <Border x:Name="FrontPaper" CornerRadius="8" BorderThickness="1" BorderBrush="#E2D6C4" Background="#F6F0E4"
                Margin="0,0,28,24">
          <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="250" Opacity="0.16" Color="#6B5A40"/>
          </Border.Effect>
          <Grid>
            <TextBox x:Name="Body"
                     Style="{StaticResource NoteBody}"
                     AutomationProperties.AutomationId="NoteBody"
                     AutomationProperties.Name="正文"
                     TextChanged="Body_TextChanged"
                     Language="zh-CN"/>
            <TextBlock x:Name="Placeholder" Text="写点什么…" Margin="16,12,12,0" VerticalAlignment="Top"
                       IsHitTestVisible="False" Foreground="#9A8F80"/>
            <TextBlock x:Name="PageBadge" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="12,0,0,8" FontSize="11" Foreground="#9A8F80" IsHitTestVisible="False"/>
          </Grid>
        </Border>
      </Grid>

      <DockPanel Grid.Row="2" Margin="10,0,10,10">
        <ToggleButton x:Name="SpreadToggle" DockPanel.Dock="Left" Style="{StaticResource PaperToggle}"
                      Content="单独列示" Height="28" Padding="10,2"
                      AutomationProperties.AutomationId="SpreadPages" AutomationProperties.Name="单独列示"
                      ToolTip="勾选后每一页单独成窗"
                      Checked="SpreadToggle_Changed" Unchecked="SpreadToggle_Changed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="加页" Style="{StaticResource PaperButton}" Height="28" Margin="0,0,6,0"
                  AutomationProperties.AutomationId="AddPage" AutomationProperties.Name="加页"
                  Click="Add_Click"/>
          <Button x:Name="RemoveButton" Content="减页" Style="{StaticResource PaperButton}" Height="28"
                  AutomationProperties.AutomationId="RemovePage" AutomationProperties.Name="减页"
                  ToolTip="把当前页从桌面拿下来"
                  Click="Unpin_Click"/>
        </StackPanel>
      </DockPanel>
    </Grid>
  </Border>
</Window>
