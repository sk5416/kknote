<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BgColor">#0B1220</Color>
  <Color x:Key="SurfaceColor">#121A2B</Color>
  <Color x:Key="RaisedColor">#1A2438</Color>
  <Color x:Key="BorderColor">#2A3A56</Color>
  <Color x:Key="TextColor">#E7EEF9</Color>
  <Color x:Key="MutedColor">#8EA0BE</Color>
  <Color x:Key="AccentColor">#3DDCFF</Color>
  <Color x:Key="VioletColor">#7C6CFF</Color>
  <Color x:Key="DangerColor">#FF5D73</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}"/>
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

  <LinearGradientBrush x:Key="AccentLineBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#3DDCFF" Offset="0"/>
    <GradientStop Color="#7C6CFF" Offset="1"/>
  </LinearGradientBrush>
</ResourceDictionary>
