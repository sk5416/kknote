<Window x:Class="KkNote.Views.TodoManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="待办"
        Width="420"
        Height="560"
        MinWidth="360"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        AutomationProperties.AutomationId="TodoManager">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <DockPanel>
      <Border DockPanel.Dock="Top" Height="2" Background="{StaticResource AccentLineBrush}"/>
      <Grid DockPanel.Dock="Top" Height="40" Margin="14,0,8,0">
        <TextBlock Text="待办" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        <Button Content="×" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                ToolTip="关闭" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Hide_Click"/>
      </Grid>

      <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="日期" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="FormatBox" Style="{StaticResource DarkCombo}" Width="132" Height="28"
                      SelectionChanged="FormatBox_Changed">
              <ComboBoxItem Content="MM/DD" Tag="md"/>
              <ComboBoxItem Content="YY/MM/DD" Tag="yymmdd"/>
              <ComboBoxItem Content="YYYY/MM/DD" Tag="ymd"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="临期" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="SoonBox" Style="{StaticResource DarkCombo}" Width="56" Height="28"
                      SelectionChanged="SoonBox_Changed"/>
            <TextBlock Text="天" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <DockPanel DockPanel.Dock="Bottom" Margin="12,8,12,8">
        <Button x:Name="AddButton" DockPanel.Dock="Right" Content="添加" Style="{StaticResource GhostButton}"
                Margin="8,0,0,0" Click="Add_Click"/>
        <Button x:Name="AddDateButton" DockPanel.Dock="Right" Content="+" Width="32" Height="32"
                Style="{StaticResource GhostButton}" Padding="0" Margin="8,0,0,0"
                ToolTip="可选日期" Click="AddDateButton_Click"/>
        <Popup x:Name="AddDatePopup" PlacementTarget="{Binding ElementName=AddDateButton}"
               Placement="Top" AllowsTransparency="True" StaysOpen="False">
          <Border Margin="0,0,0,4" Padding="8" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
              <Calendar x:Name="AddPicker" SelectedDatesChanged="AddPicker_Changed"/>
              <Button Content="不用日期" Margin="0,8,0,0" Padding="8,4" Style="{StaticResource GhostButton}"
                      Click="ClearAddDate_Click"/>
            </StackPanel>
          </Border>
        </Popup>
        <TextBox x:Name="AddBox" Style="{StaticResource FieldTextBox}" Height="32"
                 KeyDown="AddBox_KeyDown"/>
      </DockPanel>

      <DockPanel DockPanel.Dock="Top" Margin="12,0,12,8">
        <ToggleButton x:Name="ShowDoneBox" Content="显示已完成" Style="{StaticResource CheckToggle}"
                      Height="28" Padding="10,2" HorizontalAlignment="Left"
                      Checked="ShowDone_Changed" Unchecked="ShowDone_Changed"/>
      </DockPanel>

      <Grid Margin="12,0,12,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="Rows"/>
        </ScrollViewer>
        <TextBlock x:Name="EmptyHint" Text="还没有待办。在下面输入内容后点「添加」。"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                   IsHitTestVisible="False"/>
      </Grid>
    </DockPanel>
  </Border>
</Window>
