<UserControl x:Class="KkNote.Views.TodoRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
  <Border x:Name="Box"
          AllowDrop="True"
          DragOver="Box_DragOver"
          DragLeave="Box_DragLeave"
          Drop="Box_Drop"
          BorderThickness="1"
          CornerRadius="6"
          Padding="8,5"
          Margin="0,0,0,6"
          BorderBrush="#D9CDBB"
          Background="#80FFFFFF">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="DragHandle"
              VerticalAlignment="Center"
              Margin="0,0,8,0"
              Padding="2,0"
              Cursor="SizeAll"
              ToolTip="拖动排序"
              Background="Transparent"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
              PreviewMouseMove="DragHandle_MouseMove"
              PreviewMouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
        <TextBlock x:Name="IndexLabel" FontSize="12" Foreground="#9A8F80"/>
      </Border>
      <CheckBox x:Name="DoneBox"
                Grid.Column="1"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Checked="DoneBox_Changed"
                Unchecked="DoneBox_Changed"/>
      <TextBox x:Name="TextBox"
               Grid.Column="2"
               BorderThickness="0"
               Background="Transparent"
               Padding="0,1"
               VerticalAlignment="Center"
               AcceptsReturn="False"
               TextWrapping="Wrap"
               LostFocus="TextBox_LostFocus"
               KeyDown="TextBox_KeyDown"/>
      <Button x:Name="DateButton"
              Grid.Column="3"
              MinWidth="36"
              Height="20"
              Margin="8,0,0,0"
              Padding="6,0"
              FontSize="11"
              VerticalAlignment="Center"
              Click="DateButton_Click"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chip"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Button.Template>
      </Button>
      <Popup x:Name="DatePopup"
             PlacementTarget="{Binding ElementName=DateButton}"
             Placement="Bottom"
             AllowsTransparency="True"
             StaysOpen="False">
        <Border Margin="0,4,0,0" Padding="8" CornerRadius="8" Background="#FBF6EE" BorderBrush="#D9CDBB" BorderThickness="1"
                x:Name="DatePopupBorder">
          <StackPanel>
            <Calendar x:Name="Picker" SelectedDatesChanged="Picker_SelectedDatesChanged"/>
            <Button Content="清除日期" Margin="0,8,0,0" Padding="8,4" Click="ClearDate_Click"/>
          </StackPanel>
        </Border>
      </Popup>
      <Button x:Name="RemoveButton"
              Grid.Column="4"
              Content="×"
              Width="22"
              Height="22"
              Margin="6,0,0,0"
              Padding="0"
              FontSize="12"
              Click="Remove_Click"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    </Grid>
  </Border>
</UserControl>
