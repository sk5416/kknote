<Window x:Class="KkNote.Views.StickyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:KkNote.Views"
        Title="便签"
        Width="320"
        Height="380"
        MinWidth="240"
        MinHeight="210"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="{Binding AlwaysOnTop}"
        Background="#EFE6D4"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI"
        AutomationProperties.AutomationId="StickyNote"
        PreviewMouseRightButtonUp="Window_PreviewMouseRightButtonUp">
  <Window.ContextMenu>
    <ContextMenu x:Name="PageMenu" Opened="PageMenu_Opened"/>
  </Window.ContextMenu>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border x:Name="Root" BorderThickness="1" Background="#EFE6D4" BorderBrush="#D9CDBB">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid x:Name="Header" Grid.Row="0" Background="#F6F0E4">
        <TextBlock x:Name="TitleLabel"
                   Margin="14,0,148,0"
                   VerticalAlignment="Center"
                   FontSize="14"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   IsHitTestVisible="False"
                   Foreground="#2A3340"
                   AutomationProperties.AutomationId="StickyTitle"
                   AutomationProperties.Name="便签标题"
                   Text="{Binding DisplayTitle}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
          <ToggleButton x:Name="PinButton"
                        IsChecked="{Binding AlwaysOnTop}"
                        AutomationProperties.AutomationId="ToggleTopmost"
                        AutomationProperties.Name="置顶"
                        ToolTip="是否保持在最前"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <ToggleButton.Style>
              <Style TargetType="ToggleButton" BasedOn="{StaticResource PaperToggle}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="MinWidth" Value="52"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Content" Value="置顶"/>
                <Style.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="已置顶"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ToggleButton.Style>
          </ToggleButton>
          <Button x:Name="CloseButton" Content="×" Style="{StaticResource PaperIconButton}" Margin="6,0,0,0"
                  AutomationProperties.AutomationId="UnpinNote"
                  AutomationProperties.Name="取消固化"
                  ToolTip="从桌面移除，内容仍留在面板"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Unpin_Click"/>
        </StackPanel>
      </Grid>

      <views:NoteStyleBar x:Name="StyleBar" Grid.Row="2" Margin="10,0,10,6"/>

      <DockPanel Grid.Row="3" Margin="10,0,10,10">
        <ToggleButton x:Name="SpreadToggle" DockPanel.Dock="Left" Style="{StaticResource PaperToggle}"
                      Content="单独列示" Height="28" Padding="10,2"
                      AutomationProperties.AutomationId="SpreadPages" AutomationProperties.Name="单独列示"
                      ToolTip="取消后，这一页回到纸沓里"
                      Checked="SpreadToggle_Changed" Unchecked="SpreadToggle_Changed"/>
      </DockPanel>

      <Grid Grid.Row="1" Margin="10,4,10,4">
        <Border x:Name="Paper" CornerRadius="8" BorderThickness="1" BorderBrush="#E2D6C4" Background="#F6F0E4">
          <Grid>
            <TextBox x:Name="Body"
                     Style="{StaticResource NoteBody}"
                     AutomationProperties.AutomationId="NoteBody"
                     AutomationProperties.Name="正文"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     Language="zh-CN"/>
            <TextBlock Text="写点什么…" Margin="16,12,12,0" VerticalAlignment="Top"
                       IsHitTestVisible="False" Foreground="#9A8F80">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
