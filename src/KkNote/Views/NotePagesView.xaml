<UserControl x:Class="KkNote.Views.NotePagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             SnapsToDevicePixels="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer x:Name="SpreadStrip"
                  Grid.Row="0"
                  Margin="8,8,8,0"
                  Visibility="Collapsed"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled"
                  Height="40">
      <StackPanel x:Name="SpreadTabs" Orientation="Horizontal"/>
    </ScrollViewer>

    <Grid x:Name="Deck" Grid.Row="1" Margin="8,8,8,4" ClipToBounds="False" MinHeight="96">
      <Grid x:Name="PeekLayer"/>
      <Border x:Name="FrontPaper"
              CornerRadius="8"
              BorderThickness="1"
              BorderBrush="#E2D6C4"
              Background="#F6F0E4"
              Margin="0,0,26,22">
        <Border.Effect>
          <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="250" Opacity="0.16" Color="#6B5A40"/>
        </Border.Effect>
        <Grid>
          <TextBox x:Name="Body"
                   Style="{StaticResource NoteBody}"
                   AutomationProperties.AutomationId="NoteBody"
                   AutomationProperties.Name="正文"
                   TextChanged="Body_TextChanged"
                   Language="zh-CN"/>
          <TextBlock x:Name="Placeholder"
                     Text="写点什么…"
                     Margin="16,12,12,0"
                     VerticalAlignment="Top"
                     IsHitTestVisible="False"
                     Foreground="#9A8F80"/>
          <TextBlock x:Name="PageBadge"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="12,0,0,8"
                     FontSize="11"
                     Foreground="#9A8F80"
                     IsHitTestVisible="False"/>
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="8,0,8,8">
      <ToggleButton x:Name="SpreadToggle"
                    DockPanel.Dock="Left"
                    Style="{StaticResource PaperToggle}"
                    Content="单独列示"
                    Height="28"
                    Padding="10,2"
                    AutomationProperties.AutomationId="SpreadPages"
                    AutomationProperties.Name="单独列示"
                    ToolTip="勾选后每一页单独排开，取消则叠成一沓纸"
                    Checked="SpreadToggle_Changed"
                    Unchecked="SpreadToggle_Changed"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="AddButton" Content="加页" Style="{StaticResource PaperButton}" Height="28" Margin="0,0,6,0"
                AutomationProperties.AutomationId="AddPage" AutomationProperties.Name="加页"
                Click="Add_Click"/>
        <Button x:Name="RemoveButton" Content="减页" Style="{StaticResource PaperButton}" Height="28"
                AutomationProperties.AutomationId="RemovePage" AutomationProperties.Name="减页"
                Click="Remove_Click"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</UserControl>
